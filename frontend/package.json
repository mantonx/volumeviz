{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:with-api": "npm run generate:api && vite",
    "build": "npm run generate:api && vite build",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "lint:deps": "eslint package.json",
    "lint:deps:fix": "eslint package.json --fix",
    "type-check": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:run:headless": "cypress run --headless",
    "e2e": "cypress run --spec 'cypress/e2e/**/*.cy.ts'",
    "e2e:open": "cypress open",
    "e2e:modern": "cypress run --spec 'cypress/e2e/modern/**/*.cy.ts'",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "api:bundle": "cd .. && npx js-yaml docs/openapi.yaml > docs/swagger.json",
    "generate:api": "orval",
    "generate:watch": "orval --watch"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@tanstack/react-query": "^5.90.2",
    "@tanstack/react-query-devtools": "^5.90.2",
    "@types/react-window": "^1.8.8",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "jotai": "^2.15.0",
    "jotai-tanstack-query": "^0.11.0",
    "lodash-es": "^4.17.21",
    "lucide-react": "^0.544.0",
    "orval": "^7.13.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.9.3",
    "react-use-websocket": "^4.13.0",
    "react-window": "^1.8.11",
    "react-window-infinite-loader": "^1.0.10",
    "recharts": "^3.2.1",
    "tailwind-merge": "^3.3.1",
    "validator": "^13.15.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@storybook/addon-docs": "^9.1.9",
    "@storybook/react-vite": "^9.1.9",
    "@storybook/testing-library": "^0.2.2",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.6.1",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/validator": "^13.15.3",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.39.0",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "cypress": "^15.3.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-package-json": "^0.56.3",
    "eslint-plugin-prettier": "^5.5.3",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "jotai-devtools": "^0.13.0",
    "js-yaml": "^4.1.0",
    "jsdom": "^26.1.0",
    "msw": "^2.11.3",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "storybook": "^9.1.1",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
