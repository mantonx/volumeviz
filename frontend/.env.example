# VolumeViz Frontend Environment Configuration

# WebSocket Configuration
# Enable/disable WebSocket real-time updates
VITE_ENABLE_WEBSOCKET=true

# WebSocket server URL
# Default: ws://[current-host]:8080/api/v1/ws
VITE_WS_URL=ws://localhost:8080/api/v1/ws

# API Configuration
# Base URL for REST API calls
# Default: http://[current-host]:8080/api/v1
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Development Configuration
# Enable development features like the WebSocket dev panel
VITE_DEV_MODE=true

# Theme Configuration
# Default theme: system, light, or dark
VITE_DEFAULT_THEME=system

# Feature Flags
# Enable/disable specific features
VITE_ENABLE_CHARTS=true
VITE_ENABLE_REALTIME_DASHBOARD=true
VITE_ENABLE_VOLUME_SCANNING=true

# Performance Settings
# WebSocket reconnection settings
VITE_WS_RECONNECT_DELAY=3000
VITE_WS_MAX_RECONNECT_ATTEMPTS=10
VITE_WS_HEARTBEAT_INTERVAL=30000

# Debug Settings
# Enable verbose logging in development
VITE_DEBUG_WEBSOCKET=false
VITE_DEBUG_API=false