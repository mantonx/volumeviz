# VolumeViz Environment Configuration
# Copy this file to .env for local development

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
# Port for the API server
API_PORT=8080
SERVER_PORT=8080

# Host for the API server to bind to
SERVER_HOST=0.0.0.0

# Gin framework mode (debug, release, test)
GIN_MODE=release

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
# Port for the frontend development server
FRONTEND_PORT=3000

# API URL that the frontend should connect to
VITE_API_URL=http://localhost:8080/api/v1

# WebSocket URL for real-time features (future use)
VITE_WS_URL=ws://localhost:8080/api/v1/ws

# Frontend feature flags
VITE_ENABLE_WEBSOCKET=false
VITE_ENABLE_POLLING=true
VITE_POLLING_INTERVAL=30000
VITE_MAX_CONCURRENT_SCANS=3
VITE_ENABLE_DEBUG=false

# =============================================================================
# DOCKER CONFIGURATION
# =============================================================================
# Docker daemon socket or TCP connection
# Local socket (default): unix:///var/run/docker.sock
# Remote TCP (dev only): tcp://host:2375
DOCKER_HOST=unix:///var/run/docker.sock

# Docker API timeout in seconds
DOCKER_TIMEOUT=30s

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Database type: postgres or sqlite
DB_TYPE=postgres

# PostgreSQL Configuration
DB_HOST=postgres
DB_PORT=5432
DB_USER=volumeviz
DB_PASSWORD=volumeviz
DB_NAME=volumeviz
DB_SSLMODE=disable

# SQLite Configuration (alternative to PostgreSQL)
# DB_TYPE=sqlite
# DB_PATH=./volumeviz.db

# Database Migrations
# Run migrations automatically on application startup
AUTO_MIGRATE=true

# =============================================================================
# SECURITY & CORS
# =============================================================================
# Allowed origins for CORS and WebSocket connections (comma-separated)
# These origins control both HTTP CORS and WebSocket origin validation
# Format: Provide full URLs with scheme (http:// or https://)
# Examples:
#   - Development: http://localhost:3000,http://localhost:5173
#   - Production: https://app.example.com,https://admin.example.com
# Security: Do NOT use wildcards (*) in production
ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173

# =============================================================================
# LOGGING & MONITORING
# =============================================================================
# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Log format (json, text)
LOG_FORMAT=json

# Enable Prometheus metrics endpoint
ENABLE_METRICS=true

# Prometheus metrics server port
METRICS_PORT=9090

# =============================================================================
# DEVELOPMENT ONLY
# =============================================================================
# Enable development features (should be false in production)
DEV_MODE=true

# Enable API documentation endpoints
ENABLE_API_DOCS=true

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# Authentication (disabled by default for development)
AUTH_ENABLED=false
# AUTH_HS256_SECRET=your-super-secret-jwt-key-at-least-32-characters

# Security Headers
SECURITY_HIDE_SERVER=true
SECURITY_ENABLE_HSTS=false
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_CONTENT_TYPE_OPTIONS=nosniff
SECURITY_FRAME_OPTIONS=SAMEORIGIN
SECURITY_REFERRER_POLICY=no-referrer
SECURITY_CSP=default-src 'none'; frame-ancestors 'self';

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=60
RATE_LIMIT_BURST=30

# =============================================================================
# TLS/HTTPS CONFIGURATION
# =============================================================================
# Leave empty for HTTP mode (development)
# Set both for HTTPS mode (production)
TLS_CERT_FILE=
TLS_KEY_FILE=

# Example for Let's Encrypt certificates:
# TLS_CERT_FILE=/etc/letsencrypt/live/your-domain.com/fullchain.pem
# TLS_KEY_FILE=/etc/letsencrypt/live/your-domain.com/privkey.pem

# =============================================================================
# DATA RETENTION CONFIGURATION
# =============================================================================
# Automatic cleanup of old data to prevent database bloat
RETENTION_ENABLED=true

# How often to run cleanup (e.g., 24h, 12h, 168h for weekly)
RETENTION_CLEANUP_INTERVAL=24h

# Run cleanup immediately on startup
RETENTION_RUN_ON_STARTUP=true

# Retention periods (in days) for different data types
RETENTION_SCAN_JOBS_DAYS=30              # Completed scan job records
RETENTION_SCAN_METRICS_DAYS=90           # Scan performance metrics
RETENTION_SCAN_PHASES_DAYS=7             # Scan phase tracking data
RETENTION_FILE_METADATA_DAYS=180         # File metadata records
RETENTION_INACTIVE_FILES_DAYS=60         # Files not seen in recent scans

# =============================================================================
# SCAN RESILIENCE CONFIGURATION
# =============================================================================
# Retry configuration for transient failures
SCAN_RETRY_ENABLED=true
SCAN_RETRY_MAX_ATTEMPTS=3
SCAN_RETRY_INITIAL_BACKOFF=1s
SCAN_RETRY_MAX_BACKOFF=30s

# Timeout configuration to prevent hung scans
SCAN_PER_METHOD_TIMEOUT=30m              # Timeout for individual scan methods (diskus, du, native)
SCAN_OVERALL_TIMEOUT=2h                  # Total timeout for entire scan operation
SCAN_INDEXING_TIMEOUT=4h                 # Timeout for filesystem indexing phase

# Circuit breaker to prevent cascading failures
SCAN_CIRCUIT_BREAKER_ENABLED=true        # Opens after 5 consecutive failures, resets after 1 minute

# =============================================================================
# SCAN INCREMENTAL SCANNING CONFIGURATION (For 1TB+ volumes)
# =============================================================================
# Enable incremental scanning to only rescan changed portions (99% faster rescans)
SCAN_INCREMENTAL_ENABLED=true

# Snapshot retention period - keep snapshots for change detection
SCAN_SNAPSHOT_RETENTION_DAYS=90          # Keep snapshots for 90 days

# Maximum age of snapshot to use for incremental scan (older = force full scan)
SCAN_INCREMENTAL_MAX_SNAPSHOT_AGE=168h   # 7 days (168 hours)

# Force full scan even when incremental is available (for testing)
SCAN_INCREMENTAL_FORCE_FULL=false

# =============================================================================
# MEDIA ENRICHMENT CONFIGURATION
# =============================================================================
# Enable media metadata enrichment (extracts video/audio/image metadata)
VV_ENABLE_ENRICHERS=true

# Which enrichers to enable
VV_ENABLE_FFPROBE=true                 # Extract video/audio metadata using ffprobe
VV_ENABLE_EXIF=true                    # Extract image EXIF data using exiftool
VV_ENABLE_SUBTITLE_ENRICHMENT=true     # Parse subtitle files (SRT, VTT, etc.)

# Concurrent enrichment workers (higher = faster but more CPU/memory)
# NOTE: Increased from 3 to 8 for 2-3x performance boost
VV_MAX_CONCURRENT_ENRICHERS=8          # Number of files to enrich in parallel (default was 3)

# Timeout per file (prevent hanging on corrupt files)
VV_ENRICHER_TIMEOUT_PER_FILE=30s       # Max time to spend enriching a single file
VV_FFPROBE_TIMEOUT=15s                 # FFprobe-specific timeout

# EXIF/GPS settings
VV_ENABLE_EXIF_GPS=false               # Extract GPS coordinates from images
VV_REDACT_GPS=true                     # Redact GPS data for privacy
VV_GPS_PRECISION=3                     # Decimal places for GPS coordinates

